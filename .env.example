# Copy to .env (not committed) and export before starting the server.
PLATFORM_LISTEN=127.0.0.1:8060
PLATFORM_DATABASE=sqlite://platform.db
PLATFORM_SSHX_SERVER=http://127.0.0.1:8051
PLATFORM_STATIC_DIR=build
# PLATFORM_PUBLIC_URL=https://platform.example.ts.net

# Authentication: "dev" (no password, everyone admin) until Entra ID is set up.
PLATFORM_AUTH=dev
# PLATFORM_AUTH=oidc
# PLATFORM_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# PLATFORM_OIDC_CLIENT_ID=<application-id>
# PLATFORM_OIDC_CLIENT_SECRET=<secret>
# PLATFORM_ADMINS=first.last@catie.fr
